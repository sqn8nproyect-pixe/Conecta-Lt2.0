# ─────────────────────────────────────────────────────────────
# Conecta-LT 3.0 — Variables de entorno
# ─────────────────────────────────────────────────────────────
# Copia este archivo a .env.local y completa los valores reales.
# NUNCA commitear .env.local (ya está en .gitignore).

# ── BASE DE DATOS (Etapa 1) ──────────────────────────────────
# SQLite (default del proyecto — no requiere servidor externo).
# El archivo se crea automáticamente en db/dev.db al correr `bun run db:push`.
DATABASE_URL="file:/home/z/my-project/db/dev.db"

# ── AUTENTICACIÓN (Etapa 2) ──────────────────────────────────
# NextAuth v4 — JWT strategy. Sin NEXTAUTH_SECRET, las cookies de sesión
# NO se pueden desencriptar en los route handlers (getServerSession
# devuelve null y todos los endpoints /api/* responden 401).
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="genera-un-secret-aleatorio-de-32-bytes"
NEXTAUTH_URL="http://localhost:3000"

# Alias v5 (mismo valor que NEXTAUTH_SECRET — Auth.js v5 naming)
AUTH_SECRET="genera-un-secret-aleatorio-de-32-bytes"
AUTH_URL="http://localhost:3000"

# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"

# URL pública de la app (sin slash final)
# Local: http://localhost:3000  |  Prod: https://conectalt.vercel.app
# (ya definida arriba como NEXTAUTH_URL / AUTH_URL)

# ── STORAGE DE IMÁGENES (Etapa 3) ────────────────────────────
# Cloudflare R2 (gratis hasta 10GB): https://dash.cloudflare.com
R2_ACCOUNT_ID="tu-account-id"
R2_ACCESS_KEY_ID="tu-access-key"
R2_SECRET_ACCESS_KEY="tu-secret-key"
R2_BUCKET_NAME="conecta-lt-images"
R2_PUBLIC_URL="https://images.conectalt.com"

# ── EMAIL (Etapa 3 — notificaciones de reserva) ─────────────
# Resend: https://resend.com (gratis hasta 3000/mes)
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Conecta-LT <notificaciones@conectalt.com>"

# ── WHATSAPP BUSINESS API (Etapa 6) ──────────────────────────
# Meta for Developers: https://developers.facebook.com/apps
WHATSAPP_TOKEN="tu-whatsapp-business-token"
WHATSAPP_PHONE_NUMBER_ID="tu-phone-number-id"

# ── AI ENRIQUECIMIENTO (Etapa 4) ────────────────────────────
# z-ai-web-dev-sdk ya configurado en el proyecto
# Para Gemini directo: https://aistudio.google.com/apikey
GEMINI_API_KEY="tu-gemini-api-key"

# ── APP ─────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Conecta-LT"
NEXT_PUBLIC_DEFAULT_CITY="los-teques"
NEXT_PUBLIC_DEFAULT_TIMEZONE="America/Caracas"
